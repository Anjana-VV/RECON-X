{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FragmentSchema",
  "type": "object",
  "properties": {
    "fragment_id": {
      "type": "string"
    },
    "offset_start": {
      "type": "integer",
      "minimum": 0
    },
    "offset_end": {
      "type": "integer",
      "minimum": 0
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "predicted_type": {
      "type": "string"
    },
    "classifier_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "sha256": {
      "type": "string"
    },
    "header_detected": {
      "type": "boolean"
    },
    "footer_detected": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["CANDIDATE", "VALIDATED", "REJECTED", "PARTIAL"]
    },
    "output_path": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "fragment_id",
    "offset_start",
    "offset_end",
    "size_bytes",
    "predicted_type",
    "classifier_confidence",
    "sha256",
    "header_detected",
    "footer_detected",
    "status"
  ],
  "additionalProperties": false
}
